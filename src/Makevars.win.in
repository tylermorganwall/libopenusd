# R compiles the package sources and links its shared library using these flags.
CMAKE = @CMAKE@
PKG_CPPFLAGS = @RCPP_FLAGS@ -DPXR_STATIC -I../inst/include -Ibuild/OpenUSD/include -I@TBB_INCLUDE@
PKG_LIBS = @OPENUSD_LIBS@ @TBB_LIBS@ @PLATFORM_LIBS@

all: $(SHLIB)

# OpenUSD creates headers as well as its archive. Finish the vendored build
# before R compiles any interface object, including with parallel make.
$(OBJECTS): build/openusd-built
$(SHLIB): build/openusd-built

build/openusd-built: ../tools/vendor/cmake/CMakeLists.txt build/Makefile ../tools/install-resources.R
	"$(CMAKE)" --build build --target usd_m --parallel @JOBS@
	"$(CMAKE)" --install build --config Release > build/install.log
	"$(R_HOME)/bin@R_ARCH_BIN@/@RSCRIPT@" ../tools/install-resources.R
	touch $@
